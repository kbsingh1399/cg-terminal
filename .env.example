# CG Order-Flow Terminal — environment
# Copy to .env and adjust. Only DATABASE_URL is needed by the template's
# Prisma scaffold — the terminal itself needs NO API keys (it speaks the
# Coinglass web API directly, exactly like a logged-out browser tab).

DATABASE_URL="file:./db/custom.db"

# --- Continuity engine ------------------------------------------------------
# CG_ENGINE=off                 # disable the background engine + scanner
CG_ENGINE_BACKFILL_DAYS=3       # how far boot backfill reaches on a fresh store (1-30)
# CG_ENGINE_BOOT_DELAY_MS=15000 # delay before boot backfill starts

# --- Storage & cache bounds (long-uptime stability) --------------------------
# CG_STORE_MAX_ROWS=60000       # per-series row cap (file compacts when 20% over)
# CG_CLIENT_CACHE_MAX=800       # upstream response cache entries (oldest evicted)
# CG_DATA_DIR=data/cg-series    # where the JSONL continuity store lives

# --- Live price ticker ------------------------------------------------------
# CG_TICKER_TTL_MS=3000         # upstream refresh for the 1s price feed (min 1000)

# --- Notification scanner ---------------------------------------------------
# CG_SCAN=off                   # disable the notification scanner
# CG_SCAN_ASSETS=BTC,ETH,XAU    # restrict scanning to a subset (default: all 12)

# --- MCP server (mcp/server.mjs) --------------------------------------------
# TERMINAL_URL=http://localhost:3000
